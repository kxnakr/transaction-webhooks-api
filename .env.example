# Database
DATABASE_URL=postgresql://user:password@neon-host.neon.tech/wfg-transaction-webhooks-api?sslmode=require
DATABASE_POOL_PRE_PING=True
DATABASE_POOL_RECYCLE=600
DATABASE_POOL_TIMEOUT=30

# Redis (Upstash)
UPSTASH_REDIS_HOST=upstash-redis.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=upstash_password

# Optional:

# Application
APP_NAME=wfg-transaction-webhooks-api
DEBUG=False

# Database Connection Pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
